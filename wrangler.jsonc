{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newmarker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_KAKAO_MAP_APP_KEY": "223e7ae08e4de052f9b928968c485d27",
    "NEXT_PUBLIC_SUPABASE_URL": "https://bgdqjtmkdprqencgnrbx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_apsLHlcVZy1F32x7-NrB0g_LNe-X__S",
    // VWorld 인증키(브라우저 JSONP 직접 호출용). 도메인/Referer 제한으로 보호됨 →
    // VWorld 콘솔에 서비스 도메인(localhost·newmarker.celyoon.workers.dev) 등록 필요.
    "NEXT_PUBLIC_VWORLD_API_KEY": "9D6E537F-D2D8-3555-84C1-2DA37C648083"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "newmarker"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
