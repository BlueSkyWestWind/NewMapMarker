# ─────────────────────────────────────────────────────────────
# 환경변수 목록(값 없음). 복사해서 `.env.local`로 쓰고 값을 채운 뒤 dev 서버를 재시작한다.
#   cp .env.example .env.local
# `.env.local`은 커밋되지 않는다(.gitignore). 이 파일에는 실제 값을 절대 적지 않는다.
# 배포(Cloudflare) 변수는 README의 "Cloudflare Workers 배포" 참고.
# ─────────────────────────────────────────────────────────────

# ── 브라우저에 공개되는 값 (NEXT_PUBLIC_*) ──────────────────────
# 카카오 지도 — 개발자 콘솔의 "JavaScript 키" (REST 키 아님). 도메인 제한으로 보호한다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
# Supabase — 프로젝트 URL과 publishable(anon) 키. 데이터 보호는 RLS(authenticated 전용)가 맡는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# VWorld(국토교통부 공간정보) — 브라우저 JSONP 직접 호출용. 키에 등록한 도메인(localhost 등)과 맞아야 한다.
NEXT_PUBLIC_VWORLD_API_KEY=

# ── 서버 전용 (NEXT_PUBLIC_ 접두사 금지 — 번들에 박혀 비로그인 방문자에게 노출된다) ──
# 카카오 REST API 키 — 지도 캡처(정적맵)와 길찾기 프록시에서 사용
KAKAO_REST_API_KEY=
# ITS 국가교통정보센터 CCTV 인증키. 로그인한 사용자에게만 /api/its-key 로 전달된다.
ITS_API_KEY=
# 기상청 — 아래 둘 중 하나 이상. API 허브 키를 우선 쓴다.
KMA_API_HUB_KEY=
KMA_SERVICE_KEY=

# ── 선택 ───────────────────────────────────────────────────────
# 로컬이 localhost:3000이 아니거나 커스텀 도메인을 쓸 때: 프록시 라우트가 허용할 origin
NEXT_PUBLIC_SITE_URL=
# 프록시 라우트가 추가로 허용할 origin (쉼표 구분)
PROXY_ALLOWED_ORIGINS=
